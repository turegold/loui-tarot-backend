# 로컬 개발용 설정 템플릿.
# 이 파일을 application-local.yml로 복사한 뒤 실제 값을 채워서 쓴다.
# application-local.yml 자체는 .gitignore에 포함돼 있어 커밋되지 않는다.
spring:
  datasource:
    url: jdbc:mysql://localhost:3309/loui_tarot?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: your-local-mysql-username
    password: your-local-mysql-password
  jpa:
    hibernate:
      ddl-auto: update # 로컬에서만 엔티티 기준 자동 스키마 갱신 허용. prod는 validate로 막아둠
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  data:
    redis:
      host: localhost
      port: 6380

# 아직 코드에서 안 읽지만, 카카오 로그인/JWT 구현 시 바로 쓰도록 미리 shape만 잡아둠
jwt:
  secret: replace-with-any-long-random-string-for-local-dev-only
  access-token-expiration-ms: 3600000 # 1시간
  refresh-token-expiration-ms: 1209600000 # 14일

kakao:
  client-id: your-kakao-rest-api-key
  client-secret: # Client Secret 사용이 콘솔에서 꺼져 있으면 비워둔다
  redirect-uri: http://localhost:3001/login/kakao/callback

ai:
  nvidia:
    api-key: your-nvidia-api-key # build.nvidia.com에서 발급
    model: google/gemma-4-31b-it

app:
  frontend-url: http://localhost:3001
  # 같은 와이파이의 휴대폰 등으로 모바일 테스트할 때만 채운다 (선택, 비우면 무시됨).
  # frontend-lan-url: http://<이 머신의 로컬 IP>:3001

logging:
  level:
    com.louitarot: DEBUG
