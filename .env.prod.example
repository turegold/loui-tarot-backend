# 운영 배포용 환경변수 템플릿. 이 파일을 .env.prod로 복사한 뒤 실제 값을 채운다.
# .env.prod 자체는 .gitignore에 포함되어 커밋되지 않는다.

# RDS 엔드포인트 호스트명만 (jdbc:mysql://... 나머지는 docker-compose.prod.yml에서 조합)
DB_HOST=your-db-instance.xxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

JWT_SECRET=replace-with-a-long-random-string

KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-domain.com/login/kakao/callback

# 지금은 AI 호출을 안 쓰므로(템플릿 조합으로 대체) 비워둬도 기동에 문제없다.
NVIDIA_API_KEY=

FRONTEND_URL=https://your-domain.com
